# Get your API key from https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=
# Exact name of the active CyberSWE worker snapshot in Daytona
DAYTONA_SNAPSHOT=

# Hard wall-clock limit for every sandbox, including one whose controller dies.
DAYTONA_SANDBOX_MAX_LIFETIME_MINUTES=240
# Failed jobs are stopped immediately, retained this long for recovery, then deleted.
DAYTONA_SANDBOX_RECOVERY_RETENTION_MINUTES=120

# Optional override. By default the controller reads only openrouter_api_key
# from $HOME/.rv/auth.json and injects it into the disposable sandbox at runtime.
# Never put the key itself in this file or in the worker snapshot.
# RV_AUTH_PATH=/absolute/path/to/.rv/auth.json

# Codex uses an interactive ChatGPT device login inside each disposable sandbox.
# Model being run after that login succeeds.
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=high

# Local directory where verified handoff ZIPs are downloaded
LOCAL_OUTPUT_DIR=./outputs
